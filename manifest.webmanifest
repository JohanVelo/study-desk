      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Review flashcards",
      "short_name": "Flashcards",
      "description": "Review the flashcards that are due",
      "url": "./?do=cards",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Search",
      "short_name": "Search",
      "description": "Find a topic or something in your notes",
      "url": "./?do=search",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Add a card or notes",
      "short_name": "Add",
      "description": "Quickly add a flashcard, notes or a subject",
      "url": "./?do=add",
      "icons": [
